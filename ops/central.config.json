{
  "main_branch": "main",
  "branch_prefix": "codex/",
  "trunk_dir": null,
  "shared_dir": null,
  "link_dirs": [],
  "build": {
    "cmd": "python3 ops/selftest.py",
    "cwd": "."
  },
  "verify": [
    {
      "name": "selftest",
      "cmd": "python3 ops/selftest.py",
      "cwd": "."
    },
    {
      "name": "panel-logic",
      "cmd": "python3 ops/panel_logic_check.py",
      "cwd": "."
    },
    {
      "name": "panel-render",
      "cmd": "python3 ops/panel_render_check.py --no-shot",
      "cwd": "."
    }
  ],
  "auto_port": {
    "enabled": false,
    "max_unlanded": 2
  },
  "default_lane": "bug",
  "auto_exec": {
    "enabled": false,
    "max_per_cycle": 1,
    "timeout": 3600,
    "sandbox": "workspace-write",
    "model": null,
    "model_routes": {
      "quick": {"model": null, "reasoning_effort": "low"},
      "standard": {"model": null, "reasoning_effort": "medium"},
      "deep": {"model": null, "reasoning_effort": "high"}
    },
    "retries": 3
  }
}
