{
  "main_branch": "main",
  "branch_prefix": "codex/",
  "trunk_dir": null,
  "shared_dir": null,
  "link_dirs": [
    "frontend",
    "backend"
  ],
  "build": {
    "cmd": "npm run build",
    "cwd": "frontend"
  },
  "verify": [
    {
      "name": "tsc",
      "cmd": "npx tsc --noEmit",
      "cwd": "frontend"
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "cwd": "frontend"
    }
  ],
  "auto_port": {
    "enabled": false,
    "max_unlanded": 2
  },
  "default_lane": "bug"
}
